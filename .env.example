# ==============================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (Never prefix with VITE_)
# Set these in your hosting environment (e.g. Vercel Project Settings) or local .env
# ==============================================================================

# PostgreSQL / Neon Database Connection String (Server-only secret)
DATABASE_URL=postgresql://username:password@ep-sample-12345.region.aws.neon.tech/neondb?sslmode=require

# Session Signing Secret (Must be random, minimum 32 characters in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-random-32-character-session-secret-here

# Legacy Password Migration Secret (The old VITE_JWT_SECRET used to hash legacy passwords)
# Required only during the 30-day migration window so existing users can log in and upgrade to bcrypt.
LEGACY_HASH_SECRET=your-old-legacy-jwt-secret-if-migrating

# Cutoff timestamp in ISO format for legacy SHA-256 logins (optional, defaults to 30 days)
# LEGACY_PASSWORD_CUTOFF=2026-11-25T00:00:00Z

# Application Root URL (Used for CSRF validation and password reset email links)
APP_URL=http://localhost:5173

# Email Service (SMTP) for sending password reset tokens and verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Academic Quiz System <noreply@quizsystem.com>"
SMTP_SECURE=false

# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Safe to be public in browser bundle)
# ==============================================================================

# Public Web URL
VITE_APP_URL=http://localhost:5173

# Cloudinary CDN (For student proctoring snapshots & webcam logs)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset